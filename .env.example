# ============================================================
# Brightwick — Environment Variables Template
# Copy this to .env and fill in your real values.
# NEVER commit .env to git. It is in .gitignore.
# ============================================================

# --- Companies House ---
COMPANIES_HOUSE_API_KEY=your_ch_api_key_here

# --- LLM (primary: Gemini 2.5 Flash-Lite) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# --- LLM fallback: Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- Email receive (Cloudflare-forwarded inbox IMAP) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_reply_email@gmail.com
IMAP_PASSWORD=your_app_password_here

# --- Email send (pluggable — Option A: set when going live) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=outreach@brightwick.co.uk
# SMTP_PASSWORD=your_app_password_here
# SMTP_FROM_NAME=Your Name | Brightwick
# SMTP_FROM_EMAIL=outreach@brightwick.co.uk

# --- Supabase (remote DB mirror + dashboard source) ---
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# --- Sender identity (required in every email for PECR compliance) ---
SENDER_REAL_NAME=Your Full Legal Name
SENDER_TRADING_NAME=Brightwick
SENDER_POSTAL_ADDRESS=Your Address Line 1, Town, County, Postcode
SENDER_WEBSITE=https://brightwick.co.uk
SENDER_EMAIL=outreach@brightwick.co.uk

# --- Dashboard auth ---
DASHBOARD_SECRET=change_this_to_a_random_string

# --- Pipeline settings ---
MAX_EMAILS_PER_DAY=5       # Week 1. Increase to 15 (wk2), 30 (wk3) manually
SCRAPE_DELAY_SECONDS=1     # Delay between Companies House API calls (respect 600/5min)
DB_PATH=/data/brightwick.db
